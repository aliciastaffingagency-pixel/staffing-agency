# Copy to .env.local and fill in. Never commit real values.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Session pooler (IPv4). URL-encode special characters in the password (@ -> %40).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres

NEXT_PUBLIC_AGENCY_SLUG=alicia
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# --- Payments ---------------------------------------------------------------
# M-Pesa Daraja (STK Push). MPESA_ENV = sandbox | production  (simulate = local dev only)
# MPESA_ENV=sandbox
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=174379
# MPESA_PASSKEY=
# MPESA_TRANSACTION_TYPE=CustomerPayBillOnline   # or CustomerBuyGoodsOnline for a till
# MPESA_PARTY_B=                                  # till number when using Buy Goods
# MPESA_CALLBACK_SECRET=                          # long random string; part of the callback URL
# MPESA_CALLBACK_BASE_URL=                        # e.g. an ngrok URL when testing locally
# Paystack (cards, KES)
# PAYSTACK_SECRET_KEY=
# Notifications
# RESEND_API_KEY=
# EMAIL_FROM="Alicia Staffing Agency <hello@yourdomain.co.ke>"
# AFRICASTALKING_USERNAME=sandbox
# AFRICASTALKING_API_KEY=
# AFRICASTALKING_SENDER_ID=

# --- AI (Smart match + website concierge). Without it, both use built-in rules. ---
# ANTHROPIC_API_KEY=
